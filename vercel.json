{
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/en/index.html" },
    { "source": "/docs", "destination": "/en/docs.html" },
    { "source": "/en/docs", "destination": "/en/docs.html" },
    { "source": "/es/docs", "destination": "/es/docs.html" },
    { "source": "/pt/docs", "destination": "/pt/docs.html" },
      { "source": "/en/terms", "destination": "/en/terms.html" },
      { "source": "/pt/terms", "destination": "/pt/terms.html" },
      { "source": "/es/terms", "destination": "/es/terms.html" },
      { "source": "/en/privacy", "destination": "/en/privacy.html" },
      { "source": "/pt/privacy", "destination": "/pt/privacy.html" },
      { "source": "/es/privacy", "destination": "/es/privacy.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/pt", "destination": "/pt/index.html" },
    { "source": "/es", "destination": "/es/index.html" },
    { "source": "/404", "destination": "/404.html" }
  ]
}
